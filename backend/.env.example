# =============================================================================
#  Variables de entorno - API de solicitudes de soporte técnico
#  Copia este archivo como ".env" para desarrollo local:
#      cp .env.example .env
#  En Render NO se usa este archivo: las variables se configuran en el
#  dashboard del servicio (Environment -> Add Environment Variable).
# =============================================================================

# --- Base de datos (OBLIGATORIA) ---------------------------------------------
# Neon -> Dashboard -> Connect -> Connection string (elige "Pooled connection").
# Debe incluir sslmode=require (si no lo trae, la API lo agrega solo).
DATABASE_URL=postgresql://usuario:contrasena@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Clave de la API (OBLIGATORIA en producción) ------------------------------
# Se envía en el header X-API-Key desde n8n. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=cambia-esta-clave-por-una-segura

# --- Opcionales ---------------------------------------------------------------
# Puerto del servidor (Render lo inyecta automáticamente; en local 5000)
PORT=5000

# Modo depuración de Flask: true | false
FLASK_DEBUG=false

# Correo del administrador de soporte (lo usa el workflow de n8n para avisos)
ADMIN_EMAIL=admin@escuela.edu.mx

# Orígenes permitidos para CORS (por defecto *). Ejemplo: https://midominio.com
CORS_ORIGINS=*
