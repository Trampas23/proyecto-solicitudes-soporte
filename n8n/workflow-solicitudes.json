        "id": "8d2a1b3f-5c4e-4f60-9b1c-2d3e4f5a6b02",
        "name": "Google Sheets Trigger",
        "type": "n8n-nodes-base.googleSheetsTrigger",
        "typeVersion": 1,
        "position": [
          0,
          0
        ]
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "\n/**\n * Normaliza la fila del Google Sheets Trigger y arma el JSON de la API.\n * - Tolera encabezados con sufijos (ej. \"Categoría del problema [Fila 1]\").\n * - Ignora filas vacías (sin nombre, correo o descripción).\n * - Normaliza categoría y prioridad a los valores canónicos de la API.\n */\nconst CLAVES = {\n  nombre: 'nombre completo',\n  correo: 'correo electronico',\n  telefono: 'telefono de contacto',\n  area: 'area o departamento',\n  categoria: 'categoria del problema',\n  prioridad: 'prioridad de atencion',\n  descripcion: 'descripcion detallada del problema',\n  marca: 'marca temporal',\n};\n\nconst CATEGORIAS = ['Hardware', 'Software', 'Redes e Internet', 'Accesos y contraseñas', 'Impresoras', 'Otro'];\nconst PRIORIDADES = ['Baja', 'Media', 'Alta', 'Crítica'];\n\nconst ALIAS_CAT = {\n  redes: 'Redes e Internet', red: 'Redes e Internet', internet: 'Redes e Internet', wifi: 'Redes e Internet',\n  accesos: 'Accesos y contraseñas', acceso: 'Accesos y contraseñas', contrasenas: 'Accesos y contraseñas',\n  impresora: 'Impresoras', impresion: 'Impresoras',\n  equipo: 'Hardware', equipos: 'Hardware', pc: 'Hardware',\n  programa: 'Software', programas: 'Software', sistema: 'Software',\n};\n\nconst ALIAS_PRI = {\n  bajo: 'Baja', media: 'Media', medio: 'Media', normal: 'Media',\n  alto: 'Alta', critica: 'Crítica', critico: 'Crítica', urgente: 'Crítica', inmediata: 'Crítica',\n};\n\nconst normalizar = (txt) =>\n  String(txt == null ? '' : txt)\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .toLowerCase()\n    .replace(/\\s+/g, ' ')\n    .trim();\n\nconst limpiar = (v) => String(v == null ? '' : v).replace(/\\s+/g, ' ').trim();\n\nfunction valorDe(fila, claveBuscada) {\n  const objetivo = normalizar(claveBuscada);\n  for (const [k, v] of Object.entries(fila)) {\n    const nombre = normalizar(String(k).replace(/\\[[^\\]]*\\]/g, ''));\n    if (nombre === objetivo || nombre.startsWith(objetivo)) return v;\n  }\n  return '';\n}\n\nfunction canon(valor, lista, alias, porDefecto) {\n  const n = normalizar(valor);\n  for (const opcion of lista) if (normalizar(opcion) === n) return opcion;\n  return alias[n] || porDefecto;\n}\n\nconst salida = [];\n\nfor (const item of $input.all()) {\n  const fila = (item && item.json) || {};\n\n  const nombre = limpiar(valorDe(fila, CLAVES.nombre));\n  const correo = limpiar(valorDe(fila, CLAVES.correo)).toLowerCase();\n  const descripcion = limpiar(valorDe(fila, CLAVES.descripcion));\n\n  // Ignora filas vacías o incompletas (no genera correos de alerta)\n  if (!nombre || !correo || !descripcion) continue;\n\n  const telefono = limpiar(valorDe(fila, CLAVES.telefono)) || null;\n  const area = limpiar(valorDe(fila, CLAVES.area)) || null;\n  const categoria = canon(valorDe(fila, CLAVES.categoria), CATEGORIAS, ALIAS_CAT, 'Otro');\n  const prioridad = canon(valorDe(fila, CLAVES.prioridad), PRIORIDADES, ALIAS_PRI, 'Media');\n\n  const marca = limpiar(valorDe(fila, CLAVES.marca));\n  const slug = (marca || correo).replace(/[^A-Za-z0-9]/g, '');\n  const idExterno = ('form-' + slug).slice(0, 120);\n\n  salida.push({\n    json: { nombre, correo, telefono, area, categoria, prioridad, descripcion, id_externo: idExterno, marca_temporal: marca },\n  });\n}\n\nreturn salida;\n"
        },
        "id": "9e3b2c4a-6d5f-4061-8c2d-3e4f5a6b7c03",
        "name": "Normalizar fila",
