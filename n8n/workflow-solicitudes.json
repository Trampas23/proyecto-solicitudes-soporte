    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.data.correo }}",
        "subject": "=✅ Solicitud {{ $json.data.folio }} registrada · Soporte técnico",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html lang=\"es\">\n  <body style=\"margin:0;padding:24px;background:#eef2f9;font-family:Arial,Helvetica,sans-serif;color:#1f2937;\">\n    <div style=\"max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #dbe3ef;border-radius:12px;overflow:hidden;\">\n      <div style=\"background:#1d4ed8;padding:20px 24px;\">\n        <h1 style=\"margin:0;font-size:20px;color:#ffffff;\">Soporte técnico · Solicitud registrada</h1>\n      </div>\n      <div style=\"padding:24px;\">\n        <p style=\"margin:0 0 12px;\">Hola <strong>{{ $json.data.nombre }}</strong>,</p>\n        <p style=\"margin:0 0 20px;\">Recibimos tu solicitud y quedó registrada en el sistema. Guarda el folio para dar seguimiento.</p>\n        <table style=\"width:100%;border-collapse:collapse;font-size:14px;\">\n          <tr>\n            <td style=\"padding:6px 0;color:#6b7280;width:45%;\">Folio</td>\n            <td style=\"padding:6px 0;font-weight:bold;font-size:16px;color:#1d4ed8;\">{{ $json.data.folio }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:6px 0;color:#6b7280;\">Categoría</td>\n            <td style=\"padding:6px 0;\">{{ $json.data.categoria }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:6px 0;color:#6b7280;\">Prioridad</td>\n            <td style=\"padding:6px 0;\">{{ $json.data.prioridad }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:6px 0;color:#6b7280;\">Estado</td>\n            <td style=\"padding:6px 0;\">{{ $json.data.estado }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:6px 0;color:#6b7280;\">Fecha de registro</td>\n            <td style=\"padding:6px 0;\">{{ $json.data.fecha_registro }}</td>\n          </tr>\n        </table>\n        <h2 style=\"font-size:15px;margin:24px 0 8px;\">Resumen de tu solicitud</h2>\n        <p style=\"margin:0;padding:12px;background:#f8fafc;border-left:4px solid #1d4ed8;white-space:pre-wrap;\">{{ $json.data.descripcion }}</p>\n        <p style=\"margin:24px 0 0;font-size:12px;color:#6b7280;\">Este correo se generó automáticamente con n8n; no respondas a este mensaje.</p>\n      </div>\n    </div>\n  </body>\n</html>",
        "options": {
          "appendAttribution": false
        }
      },
