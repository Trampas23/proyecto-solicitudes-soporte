    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "/**\n * Normaliza la fila que entrega el Google Sheets Trigger (respuestas del Form)\n * y construye el JSON que espera la API Flask desplegada en Render.\n *\n * Columnas del formulario -> campos de la API:\n *   Nombre completo                      -> nombre\n *   Correo electrónico                   -> correo\n *   Teléfono de contacto                 -> telefono\n *   Área o departamento                  -> area\n *   Categoría del problema               -> categoria\n *   Prioridad de atención                -> prioridad\n *   Descripción detallada del problema   -> descripcion\n *   (Marca temporal)                     -> id_externo (\"form-\" + slug de la fecha)\n */\n\n// Columnas del formulario -> campos de la API\nconst COLUMNAS = {\n  nombre: 'Nombre completo',\n  correo: 'Correo electrónico',\n  telefono: 'Teléfono de contacto',\n  area: 'Área o departamento',\n  categoria: 'Categoría del problema',\n  prioridad: 'Prioridad de atención',\n  descripcion: 'Descripción detallada del problema',\n};\n\n// Valores canónicos que exige la API (database/schema.sql)\nconst CATEGORIAS = ['Hardware', 'Software', 'Redes e Internet', 'Accesos y contraseñas', 'Impresoras', 'Otro'];\nconst PRIORIDADES = ['Baja', 'Media', 'Alta', 'Crítica'];\n\n// Sinónimos frecuentes escritos por el usuario final\nconst ALIAS_CATEGORIA = {\n  redes: 'Redes e Internet',\n  red: 'Redes e Internet',\n  internet: 'Redes e Internet',\n  wifi: 'Redes e Internet',\n  accesos: 'Accesos y contraseñas',\n  acceso: 'Accesos y contraseñas',\n  contrasenas: 'Accesos y contraseñas',\n  impresora: 'Impresoras',\n  impresion: 'Impresoras',\n  equipo: 'Hardware',\n  equipos: 'Hardware',\n  pc: 'Hardware',\n  programa: 'Software',\n  programas: 'Software',\n  sistema: 'Software',\n};\n\nconst ALIAS_PRIORIDAD = {\n  bajo: 'Baja',\n  media: 'Media',\n  medio: 'Media',\n  normal: 'Media',\n  alto: 'Alta',\n  critica: 'Crítica',\n  critico: 'Crítica',\n  urgente: 'Crítica',\n  inmediata: 'Crítica',\n};\n\n// Texto comparable: sin acentos, en minúsculas y con espacios simples.\nconst comparables = (valor) =>\n  String(valor === undefined || valor === null ? '' : valor)\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .toLowerCase()\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n// Texto limpio: recorta y colapsa espacios (nunca regresa undefined).\nconst texto = (valor) =>\n  String(valor === undefined || valor === null ? '' : valor)\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n// Convierte la respuesta del formulario al valor canónico de la API.\nconst normalizar = (valor, catalogo, alias, porDefecto) => {\n  const clave = comparables(valor);\n  if (!clave) return porDefecto;\n  for (const opcion of catalogo) {\n    if (comparables(opcion) === clave) return opcion;\n  }\n  if (alias[clave]) return alias[clave];\n  return porDefecto;\n};\n\nconst slug = (valor) => texto(valor).replace(/[^0-9A-Za-z]/g, '');\n\nconst salida = [];\n\nfor (const item of $input.all()) {\n  const fila = item.json || {};\n  const marcaTemporal = texto(fila['Marca temporal']);\n\n  // Idempotencia: id_externo estable ante reintentos del workflow.\n  // El trigger \"Row Added\" no expone row_number, por lo que se usa la\n  // Marca temporal (única por respuesta) si no viene el número de fila.\n  const numeroFila = fila.row_number !== undefined ? fila.row_number : null;\n  const idExterno = numeroFila\n    ? 'form-' + numeroFila\n    : 'form-' + (slug(marcaTemporal) || 'sin-fecha');\n\n  salida.push({\n    json: {\n      nombre: texto(fila[COLUMNAS.nombre]),\n      correo: texto(fila[COLUMNAS.correo]).toLowerCase(),\n      telefono: texto(fila[COLUMNAS.telefono]) || null,\n      area: texto(fila[COLUMNAS.area]) || null,\n      categoria: normalizar(fila[COLUMNAS.categoria], CATEGORIAS, ALIAS_CATEGORIA, 'Otro'),\n      prioridad: normalizar(fila[COLUMNAS.prioridad], PRIORIDADES, ALIAS_PRIORIDAD, 'Media'),\n      descripcion: texto(fila[COLUMNAS.descripcion]),\n      id_externo: idExterno,\n    },\n  });\n}\n\nreturn salida;"
      },
      "id": "9e3b2c4a-6d5f-4061-8c2d-3e4f5a6b7c03",
      "name": "Normalizar fila",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
