        "resource": "message",
        "operation": "send",
        "sendTo": "soporte-admin@ejemplo.com",
        "subject": "=⚠️ Error al registrar una solicitud de soporte",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html lang=\"es\">\n  <body style=\"margin:0;padding:24px;background:#fef2f2;font-family:Arial,Helvetica,sans-serif;color:#1f2937;\">\n    <div style=\"max-width:640px;margin:0 auto;background:#ffffff;border:1px solid #fecaca;border-radius:12px;overflow:hidden;\">\n      <div style=\"background:#b91c1c;padding:20px 24px;\">\n        <h1 style=\"margin:0;font-size:20px;color:#ffffff;\">⚠️ No se pudo registrar una solicitud</h1>\n      </div>\n      <div style=\"padding:24px;\">\n        <p style=\"margin:0 0 16px;\">El workflow <strong>Solicitudes de soporte técnico</strong> no pudo registrar la solicitud en la API de Render.</p>\n        <table style=\"width:100%;border-collapse:collapse;font-size:14px;\">\n          <tr>\n            <td style=\"padding:6px 0;color:#6b7280;width:32%;\">Motivo reportado</td>\n            <td style=\"padding:6px 0;font-weight:bold;color:#b91c1c;\">{{ $json.mensaje || $json.message || (typeof $json.error === 'string' ? $json.error : JSON.stringify($json.error)) || 'Revisa la ejecución en n8n' }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:6px 0;color:#6b7280;\">Solicitante</td>\n            <td style=\"padding:6px 0;\">{{ $('Normalizar fila').first().json.nombre }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:6px 0;color:#6b7280;\">Correo</td>\n            <td style=\"padding:6px 0;\">{{ $('Normalizar fila').first().json.correo }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:6px 0;color:#6b7280;\">Categoría / Prioridad</td>\n            <td style=\"padding:6px 0;\">{{ $('Normalizar fila').first().json.categoria }} / {{ $('Normalizar fila').first().json.prioridad }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding:6px 0;color:#6b7280;\">Fecha del aviso</td>\n            <td style=\"padding:6px 0;\">{{ $now.format('yyyy-LL-dd HH:mm:ss') }} (America/Mexico_City)</td>\n          </tr>\n        </table>\n        <h2 style=\"font-size:14px;margin:24px 0 8px;\">Cuerpo enviado a la API</h2>\n        <pre style=\"margin:0;padding:12px;background:#f8fafc;border:1px solid #e5e7eb;border-radius:8px;font-size:12px;white-space:pre-wrap;\">{{ JSON.stringify($('Normalizar fila').first().json, null, 2) }}</pre>\n        <h2 style=\"font-size:14px;margin:16px 0 8px;\">Respuesta / error de la API</h2>\n        <pre style=\"margin:0;padding:12px;background:#f8fafc;border:1px solid #e5e7eb;border-radius:8px;font-size:12px;white-space:pre-wrap;\">{{ JSON.stringify($json, null, 2) }}</pre>\n        <p style=\"margin:24px 0 0;font-size:12px;color:#6b7280;\">Revisa la ejecución en n8n (pestaña Executions) y vuelve a ejecutar el workflow cuando el servicio esté disponible.</p>\n      </div>\n    </div>\n  </body>\n</html>",
        "options": {
